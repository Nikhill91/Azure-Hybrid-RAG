# Environments & Secrets
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/
ENV/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Vector store generated data
vector_store/*.faiss
vector_store/*.pkl
!vector_store/.gitkeep

# Uploaded documents (prevent leaking private documents)
documents/*
!documents/.gitkeep

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor settings
.vscode/
.idea/
.agents/
.claude/

# Logs
logs/
*.log

# Streamlit secrets
.streamlit/secrets.toml
